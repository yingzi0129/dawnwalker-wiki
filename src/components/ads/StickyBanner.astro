---
/**
 * StickyBanner — the sticky banner at the top of every page.
 *
 * Responsive dual unit (exactly ONE network renders per slot — mixing banner
 * networks on one page violates the density red line, docs/ads.md §五):
 *   - Mobile (<768px):  Adsterra 320×50 (`public/ads/mobile-banner.html`)
 *   - Desktop (≥768px): AdSense when PUBLIC_ADSENSE_CLIENT + _SLOT_STICKY are
 *     set, else Adsterra 728×90 (`public/ads/leaderboard.html`)
 *
 * Dismiss = THIS VISIT ONLY (sessionStorage): the banner comes back on the
 * visitor's next browsing session, close button available again — maximizes
 * impressions while keeping the escape hatch that protects bounce rate and
 * adblock adoption. (Site owner's call, 2026-09-05; was permanent localStorage
 * in the upstream template.)
 *
 * Mobile sticky note: a 50px strip under a 56px header eats ~15% of a phone's
 * first screen — the upstream template excluded mobile deliberately. Enabled
 * here per site owner, with a Plausible bounce-rate watch as the safety net.
 */
import { Icon } from 'astro-icon/components';
import AdSenseSlot from './AdSenseSlot.astro';
import { getUi } from '~/i18n/ui';
import { isLocale } from '~/i18n/routing';

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT_STICKY as string | undefined;
const showAdSense = !!(client && slot);
const current = Astro.currentLocale;
const sharedStrings =
  current && isLocale(current)
    ? ((getUi(current).shared ?? {}) as unknown as Record<string, string>)
    : {};
const closeAd = sharedStrings.closeAd ?? 'Close ad';
---

<div
  id="sticky-banner"
  class="sticky top-14 z-30 border-b border-border bg-background/95 py-2 backdrop-blur"
>
  {/* Mobile — 320×50. min-h reserves the strip height so the ad fill
      (1–2s after load) doesn't push <main> down (zero CLS). */}
  <div class="relative mx-auto flex min-h-[50px] items-center justify-center px-4 md:hidden">
    <iframe
      src="/ads/mobile-banner.html"
      width="320"
      height="50"
      style="border:0;max-width:100%;"
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
      title="Advertisement"
    />
    <button
      type="button"
      aria-label={closeAd}
      class="dismiss-sticky-btn absolute -right-1 -top-1 rounded-full border bg-background p-1 text-muted-foreground transition hover:bg-muted"
    >
      <Icon name="lucide:x" class="h-3 w-3" />
    </button>
  </div>

  {/* Desktop — 728×90 leaderboard (min-h reserves height, zero CLS). */}
  <div class="relative mx-auto hidden min-h-[90px] max-w-4xl items-center justify-center px-4 md:flex">
    {showAdSense ? (
      <AdSenseSlot position="sticky" class="mx-auto" />
    ) : (
      <iframe
        src="/ads/leaderboard.html"
        width="728"
        height="90"
        style="border:0;max-width:100%;"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
        title="Advertisement"
      />
    )}
    <button
      type="button"
      aria-label={closeAd}
      class="dismiss-sticky-btn absolute -right-1 -top-1 rounded-full border bg-background p-1 text-muted-foreground transition hover:bg-muted"
    >
      <Icon name="lucide:x" class="h-3 w-3" />
    </button>
  </div>
</div>
<script is:inline>
  (() => {
    const banner = document.getElementById('sticky-banner');
    if (!banner) return;
    // Storage can be blocked (privacy extensions / strict browsers) — degrade
    // to "dismiss works, just not remembered", same pattern as ThemeToggle.
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem('sticky-dismissed') === '1';
    } catch {
      /* storage unavailable */
    }
    if (dismissed) {
      banner.remove();
      return;
    }
    banner.querySelectorAll('.dismiss-sticky-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          sessionStorage.setItem('sticky-dismissed', '1');
        } catch {
          /* storage unavailable */
        }
        banner.remove();
      });
    });
  })();
</script>