---
/**
 * InContentAd — a page-internal ad slot (e.g. between article sections).
 *
 * TWO mutually exclusive sources — exactly ONE network renders per slot
 * (docs/ads.md §五 density red line):
 *   1. AdSense responsive unit — gated on PUBLIC_ADSENSE_CLIENT +
 *      PUBLIC_ADSENSE_SLOT_INCONTENT (primary once AdSense approves).
 *   2. Adsterra fallback — 300×250 iframe sandbox isolation, unit script
 *      lives in `public/ads/incontent.html`. NEVER paste the atOptions
 *      script into a component: all Adsterra units share the global
 *      `window.atOptions` and would overwrite each other across slots.
 *
 * Unlike StickyBanner, this is not sticky; it sits inline with content.
 */
import AdSenseSlot from './AdSenseSlot.astro';
import { getUi } from '~/i18n/ui';
import { isLocale } from '~/i18n/routing';

interface Props {
  /** Optional label override above the ad (for disclosure). */
  label?: string;
}

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT_INCONTENT as string | undefined;
const showAdSense = !!(client && slot);
// Adsterra html ships with the repo, so the slot always has content.
const show = true;
const current = Astro.currentLocale;
const sharedStrings =
  current && isLocale(current)
    ? ((getUi(current).shared ?? {}) as unknown as Record<string, string>)
    : {};
const { label = sharedStrings.adLabel ?? 'Advertisement' } = Astro.props;
---
{show && (
  <div class="my-8 flex min-h-[250px] flex-col items-center justify-center">
    <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{label}</span>
    {showAdSense ? (
      <AdSenseSlot position="incontent" />
    ) : (
      <iframe
        src="/ads/incontent.html"
        width="300"
        height="250"
        style="border:0;"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
        title="Advertisement"
      />
    )}
  </div>
)}